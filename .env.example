# Supabase — Dashboard > Project Settings > API (or `supabase status` locally)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Assistant — server only, never prefix with NEXT_PUBLIC_
# Key: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Optional: AI_PROVIDER (default "anthropic"), ANTHROPIC_MODEL (default "claude-opus-5-5")
