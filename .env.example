# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — Dashboard > Project Settings > API
# (local stack: values printed by `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Assistant — server only, never prefix with NEXT_PUBLIC_
# Key: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Optional
# AI_PROVIDER=anthropic           # LLM provider (src/lib/ai/index.ts)
# ANTHROPIC_MODEL=claude-opus-5-5 # model override
